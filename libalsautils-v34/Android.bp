// libalsautils from AOSP android14-release (system/media/alsa_utils).
// The stock audio.primary.mediatek.so was built against this version.
// Since Android 14 QPR3, alsa_device_profile has an extra field
// (extra_latency_ms) after direction, so the blob and the platform
// libalsautils disagree on the struct layout.
cc_library_shared {
    name: "libalsautils-v34",
    vendor: true,
    srcs: [
        "alsa_device_profile.c",
        "alsa_device_proxy.c",
        "alsa_format.c",
        "alsa_logging.c",
    ],
    local_include_dirs: ["include"],
    header_libs: ["libaudio_system_headers"],
    shared_libs: [
        "libaudioutils",
        "libcutils",
        "liblog",
        "libtinyalsa",
    ],
    cflags: [
        "-Werror",
        "-Wall",
        "-Wno-unused-parameter",
    ],
}

// tinyxml2 10.0.0 (AOSP external/tinyxml2 vor e261302) fuer MTK-Blobs,
// die gegen die alte ABI gebaut sind. Android 17 liefert 11.0.0.
cc_library_shared {
    name: "libtinyxml2-v10",
    vendor: true,
    srcs: ["tinyxml2.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-implicit-fallthrough",
    ],
    shared_libs: ["liblog"],
    export_include_dirs: ["."],
}
